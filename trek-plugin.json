{
  "id": "trip-todos",
  "name": "Trip To-Dos",
  "version": "1.0.1",
  "apiVersion": 1,
  "author": "mauriceboe",
  "description": "Every open to-do from all your trips, together on the dashboard and sorted by due date — overdue first — so nothing slips through the cracks.",
  "homepage": "https://github.com/mauriceboe/trek-plugin-trip-todos",
  "license": "MIT",
  "icon": "ListTodo",
  "type": "widget",
  "trek": ">=3.3.0 <5.0.0",
  "nativeModules": false,
  "permissions": ["db:read:trips", "db:read:todos"],
  "capabilities": {
    "widget": { "title": "Trip To-Dos", "slot": "sidebar" }
  },
  "routes": [
    { "method": "GET", "path": "/tasks", "auth": true }
  ]
}
